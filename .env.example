# ── Supabase ───────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Stripe ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Subscription plans — monthly
STRIPE_STARTER_MONTHLY_PRICE_ID=price_xxx
STRIPE_CREATOR_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
# Subscription plans — annual
STRIPE_STARTER_ANNUAL_PRICE_ID=price_xxx
STRIPE_CREATOR_ANNUAL_PRICE_ID=price_xxx
STRIPE_PRO_ANNUAL_PRICE_ID=price_xxx
# Top-up packs (one-time)
STRIPE_TOPUP_60_PRICE_ID=price_xxx
STRIPE_TOPUP_180_PRICE_ID=price_xxx
STRIPE_TOPUP_600_PRICE_ID=price_xxx

# ── App ────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
PORT=3000
NODE_ENV=production
